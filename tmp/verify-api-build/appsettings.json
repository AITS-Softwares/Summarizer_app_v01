{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=SummarizerApp;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Database": {
    "AutoMigrate": true
  },
  "ClientWorkflow": {
    "RestrictGenericAnalysis": true
  },
  "Storage": {
    "FilesPath": "../../storage/files",
    "DataProtectionPath": "../../storage/keys"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
